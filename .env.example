# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Only these numbers get replies (comma-separated, E.164). Everyone else is silently ignored.
ALLOWED_NUMBERS=+15551234567

# --- Twilio ---
# Send replies from this number. Defaults to the number the text was sent to.
#TWILIO_FROM_NUMBER=+15550001111
# Public URL Twilio calls, without the /sms path. Set this when behind a proxy that
# doesn't pass X-Forwarded-Proto / X-Forwarded-Host.
#PUBLIC_BASE_URL=https://your-app.example.com
# LOCAL DEV ONLY: accept unsigned webhook requests. Logs a loud warning.
#SKIP_TWILIO_VALIDATION=1

# --- Claude ---
#CLAUDE_MODEL=claude-sonnet-5-5
#CLAUDE_MAX_TOKENS=300
# low | medium | high | none (omit the parameter)
#CLAUDE_EFFORT=low
# Server-side refusal fallback (Claude API only). Set 0 on other platforms.
#CLAUDE_FALLBACKS=1
#SYSTEM_PROMPT=Override the built-in flip-phone system prompt.

# --- Memory and SMS ---
#DB_PATH=dumbbot.sqlite3
#MAX_HISTORY_TURNS=10
#HISTORY_TTL_HOURS=12
#MAX_SMS_CHARS=600

# --- Server ---
#PORT=8000
#WORKER_THREADS=4
#GUNICORN_THREADS=8
#LOG_LEVEL=INFO
